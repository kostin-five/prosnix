# Безопасный шаблон: храните реальные значения только в локальном .env или Render API Environment.
# Любая переменная VITE_* публично попадает в браузер.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5190
DATABASE_URL=postgres://awc:awc@localhost:5432/awc
# Измените, если локальный порт 5432 уже занят.
POSTGRES_PORT=5432
TELEGRAM_BOT_TOKEN=replace-with-test-bot-token
SESSION_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_AUTH_MAX_AGE_SECONDS=900
TELEGRAM_WEB_APP_URL=http://localhost:5190/
# Отдельный случайный секрет для защищённого запуска cron-job.org.
CRON_SECRET=replace-with-another-random-secret

# Только сервер. Никогда не добавляйте этот ключ в VITE_* переменные.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=12000

# Серверные защитные пределы. Для первого staging обычно не меняются.
READINESS_TIMEOUT_MS=1500
SHUTDOWN_TIMEOUT_MS=9000
AUTH_RATE_LIMIT_MAX=30
COACH_RATE_LIMIT_MAX=10
BILLING_RATE_LIMIT_MAX=10

# Числовые Telegram ID владельцев админ-панели, через запятую. Пусто = доступ закрыт всем.
ADMIN_TELEGRAM_USER_IDS=

# Версии меняются только при существенном обновлении документов.
LEGAL_PRIVACY_VERSION=2026-09-07
LEGAL_TERMS_VERSION=2026-09-07

# Монетизация безопасно выключена при 0. Для цены выше 0 обязательны webhook secret,
# TELEGRAM_WEB_APP_URL и хотя бы один ADMIN_TELEGRAM_USER_IDS для платёжной поддержки.
TELEGRAM_STARS_MONTHLY_PRICE=0
# Отдельный secret_token для Telegram webhook; минимум 32 символа, только на API.
TELEGRAM_WEBHOOK_SECRET=

# Публичные значения для страницы документов Static Site. Это НЕ секреты.
VITE_LEGAL_OPERATOR_NAME=Владелец экземпляра Prosnix
VITE_LEGAL_CONTACT=@prosnix_support
# Этап личной цели и вечерней проверки; false позволяет быстро отключить UI без потери сессий.
VITE_GOAL_CALIBRATION_ENABLED=true
# Современный shell, анимации и необязательный звук. false отключает экспериментальный слой.
VITE_GUIDED_TASK_EXPERIENCE_ENABLED=true
# Каталог включён и без переменных. Для отключения задайте false одновременно на API и web.
WAKE_TASK_CATALOG_V9_ENABLED=true
VITE_WAKE_TASK_CATALOG_V9_ENABLED=true
# Замена включена и без переменных. Явное false отключает её; API и web должны совпадать.
WAKE_TASK_SUBSTITUTION_ENABLED=true
VITE_WAKE_TASK_SUBSTITUTION_ENABLED=true
# Recovery включён и без переменной; false отключает предложение.
WAKE_LOW_EFFECT_RECOVERY_ENABLED=true
# Аналитика сочетаний остаётся отдельным выключенным пилотом.
WAKE_COMBINATION_ANALYTICS_ENABLED=false
