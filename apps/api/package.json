{
  "name": "@awc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "node ../../scripts/require-test-database.mjs && vitest run tests/integration --no-file-parallelism",
    "notifications:dispatch": "node --env-file-if-exists=../../.env dist/notifications/run-worker.js"
  },
  "dependencies": {
    "@awc/contracts": "workspace:*",
    "@awc/db": "workspace:*",
    "@awc/domain": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
