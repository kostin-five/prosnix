{
  "name": "@awc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration --passWithNoTests"
  },
  "dependencies": {
    "@awc/contracts": "workspace:*",
    "@awc/db": "workspace:*",
    "@awc/domain": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
